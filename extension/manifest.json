{
  "manifest_version": 3,
  "name": "UI 自动化录制器",
  "version": "1.1.0",
  "description": "录制浏览器操作与接口请求：自动生成可回放的测试步骤（data-uitest-id + 多级兜底），并把你真实发出的 fetch/XHR 请求录进控制台，用于筛选、定时采集与写库。",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8490/*",
    "http://localhost:8490/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UI 自动化录制器",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "uitest-keys.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "net-hook.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
